# Dev mode — talks to the dev backend on the host machine's LAN IP so
# devices on the same Wi-Fi (phones, emulators) can reach it. Set to
# 127.0.0.1 only if you're testing from the dev box itself in a browser.
#
# When the dev machine's IP changes (new Wi-Fi, DHCP renewal), update
# this value and re-run `npm run android:sync` to repackage.
VITE_API_BASE=http://192.168.1.6:3001
