# Dev mode — talks to the dev backend via the host machine's mDNS hostname, so
# devices on the same Wi-Fi (phones, emulators) reach it no matter which DHCP
# IP the PC currently has. iOS / macOS / Android resolve <host>.local via mDNS;
# Windows answers it natively. Use 127.0.0.1 only when testing from the dev box
# itself in a browser.
#
# Drift-proof: do NOT edit this when the IP changes. On a different PC, run
# `hostname`, append `.local`, and update the line below.
VITE_API_BASE=http://DESKTOP-L0C7R5A.local:3001
