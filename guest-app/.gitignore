node_modules/
dist/
.vite/

# Capacitor — keep the android/ shell (source of truth) but ignore
# the build artefacts and the synced web bundle (regenerated on every
# `cap sync` from dist/, so committing it just creates drift).
android/app/build/
android/.gradle/
android/build/
android/local.properties
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json

# iOS — CI re-generates ios/ on every build via `npx cap add ios`,
# so the entire ios/ folder is build output, not source-of-truth.
ios/

# Release signing — NEVER commit these
release.keystore
*.keystore
*.jks
keystore.properties

# Local env overrides
.env.local
.env.*.local

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
