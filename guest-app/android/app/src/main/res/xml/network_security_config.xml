<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security config for the guest kiosk debug APK.

  THIS BUILD IS DEV-PERMISSIVE: all cleartext HTTP is allowed.

  Rationale: the debug APK is built against a LAN dev backend (the URL
  baked in via .env.development, currently http://192.168.1.6:3001).
  Android does NOT treat IP entries as CIDR ranges in the per-domain
  whitelist, so listing 192.168.1.0/24 the obvious way silently fails
  to match 192.168.1.6 — every dev machine would need to be enumerated
  explicitly, and the IP changes on DHCP renewal anyway.

  For release builds you should publish a separate config (or set
  `<base-config cleartextTrafficPermitted="false">` here and override
  for `release` only via build variants) — production should be HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
