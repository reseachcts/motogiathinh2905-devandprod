# Copy this file to `android/keystore.properties`, fill in the values,
# and KEEP THE COPY OUT OF GIT (the .gitignore at guest-app/ already
# excludes *.keystore + keystore.properties).
#
# After filling in:
#   1. Generate the keystore once:
#        keytool -genkey -v -keystore release.keystore \
#                -alias guest-key -keyalg RSA -keysize 2048 -validity 10000
#      Place release.keystore in this android/ folder (where this template
#      lives), or anywhere — just match the path below.
#
#   2. android/app/build.gradle already wires up the signing config from
#      this file when it exists. Build:
#        ./gradlew assembleRelease         # signed APK
#        ./gradlew bundleRelease           # signed AAB for Play Store
#
# If keystore.properties is missing, gradle silently skips signing and
# the release build will be unsigned — fine for inspection, not for
# install on a real device.

storeFile=release.keystore
storePassword=__YOUR_STORE_PASSWORD__
keyAlias=guest-key
keyPassword=__YOUR_KEY_PASSWORD__
